<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= typeof pageTitle !== 'undefined' && pageTitle ? pageTitle + ' · Chronique Admin' : 'Chronique Admin' %></title>
<meta name="robots" content="noindex, nofollow">
<link rel="icon" href="/favicon.ico" sizes="any">
<link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32x32.png">
<link rel="apple-touch-icon" href="/assets/apple-touch-icon.png">
<style>
  :root{ --ink:#121110; --paper:#FAF8F4; --paper-dim:#EFECE4; --line:rgba(18,17,16,0.14); --accent:#121110; }
  *{box-sizing:border-box;}
  body{ margin:0; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif; background:var(--paper); color:var(--ink); }
  a{ color:inherit; }
  .wrap{ max-width:920px; margin:0 auto; padding:0 24px 80px; }
  header.admin-header{
    display:flex; align-items:center; justify-content:space-between;
    padding:20px 24px; border-bottom:1px solid var(--line); margin-bottom:32px;
  }
  header.admin-header .brand{ font-weight:700; letter-spacing:.02em; text-decoration:none; }
  header.admin-header nav a{ margin-left:18px; font-size:14px; text-decoration:none; color:#555; }
  header.admin-header nav a:hover{ color:var(--ink); }
  h1{ font-size:24px; font-weight:600; margin:0 0 6px; }
  h2{ font-size:17px; font-weight:600; margin:32px 0 12px; }
  .muted{ color:#847F73; font-size:13px; }
  .card{ border:1px solid var(--line); border-radius:10px; padding:22px; margin-bottom:18px; background:#fff; }
  .btn{
    display:inline-block; padding:10px 18px; background:var(--ink); color:var(--paper);
    border:none; border-radius:6px; font-size:14px; cursor:pointer; text-decoration:none;
  }
  .btn:hover{ opacity:.88; }
  .btn.secondary{ background:none; color:var(--ink); border:1px solid var(--line); }
  .btn.danger{ background:#B3261E; }
  .btn.small{ padding:6px 12px; font-size:12.5px; }
  form.inline{ display:inline; }
  table{ width:100%; border-collapse:collapse; margin-top:8px; }
  th, td{ text-align:left; padding:10px 8px; border-bottom:1px solid var(--line); font-size:14px; vertical-align:middle; }
  th{ color:#847F73; font-weight:500; font-size:12.5px; text-transform:uppercase; letter-spacing:.03em; }
  input[type=text], input[type=number], input[type=password], input[type=email], select, textarea{
    width:100%; padding:10px 12px; border:1px solid var(--line); border-radius:6px;
    font-size:14px; font-family:inherit; background:#fff; color:var(--ink);
  }
  textarea{ min-height:110px; resize:vertical; }
  label{ display:block; font-size:13px; font-weight:600; margin-bottom:6px; margin-top:16px; }
  label:first-child{ margin-top:0; }
  .row{ display:flex; gap:16px; }
  .row > div{ flex:1; }
  .thumb{ width:56px; height:70px; object-fit:cover; border-radius:4px; background:#eee; }
  .photo-grid{ display:flex; flex-wrap:wrap; gap:12px; margin:10px 0; }
  .photo-grid .item{ text-align:center; font-size:11px; }
  .photo-grid img{ width:90px; height:110px; object-fit:cover; border-radius:6px; display:block; margin-bottom:4px; background:#eee; }
  .error-box{ background:#fdecea; border:1px solid #f5c2c0; color:#8a2f28; padding:12px 16px; border-radius:6px; margin-bottom:20px; font-size:14px; }
  .empty{ color:#847F73; font-size:14px; padding:24px 0; }
  .tabs{ display:flex; gap:8px; margin-bottom:20px; }
  .tabs a{ padding:8px 16px; border:1px solid var(--line); border-radius:6px; text-decoration:none; font-size:13.5px; }
  .tabs a.active{ background:var(--ink); color:var(--paper); border-color:var(--ink); }
  .count-badge{ font-size:36px; font-weight:700; }
  .grid-3{ display:grid; grid-template-columns:repeat(3,1fr); gap:16px; }
  @media(max-width:640px){ .grid-3{ grid-template-columns:1fr; } .row{ flex-direction:column; } }
</style>
