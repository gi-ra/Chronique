<!DOCTYPE html>
<html lang="en">
<head><%- include('partials/head', { pageTitle: 'Log in' }) %></head>
<body>
  <div class="wrap" style="max-width:380px; padding-top:90px;">
    <h1>Chronique Admin</h1>
    <p class="muted">Sign in to add or edit products, news, videos and photos.</p>
    <% if (error) { %>
      <div class="error-box"><%= error %></div>
    <% } %>
    <form method="POST" action="/admin/login">
      <label for="username">Username</label>
      <input type="text" id="username" name="username" autocomplete="username" required>
      <label for="password">Password</label>
      <input type="password" id="password" name="password" autocomplete="current-password" required>
      <button type="submit" class="btn" style="margin-top:22px; width:100%;">Sign in</button>
    </form>
  </div>
</body>
</html>
