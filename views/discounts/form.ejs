<!DOCTYPE html>
<html lang="en">
<head><%- include('../partials/head', { pageTitle: 'Add discount code' }) %></head>
<body>
  <%- include('../partials/nav') %>
  <div class="wrap">
    <h1>Add discount code</h1>

    <form method="POST" action="/admin/discounts">
      <label for="code">Code (shoppers type this at checkout — not case-sensitive)</label>
      <input type="text" id="code" name="code" required placeholder="WELCOME10" style="text-transform:uppercase;">

      <div class="row">
        <div>
          <label for="type">Type</label>
          <select id="type" name="type">
            <option value="percent">Percent off</option>
            <option value="fixed">Fixed amount off (AUD)</option>
          </select>
        </div>
        <div>
          <label for="value">Value (e.g. 10 for 10%, or 15 for $15 off)</label>
          <input type="number" id="value" name="value" min="0" step="0.01" required>
        </div>
      </div>

      <div class="row">
        <div>
          <label for="minSubtotal">Minimum order (AUD, optional)</label>
          <input type="number" id="minSubtotal" name="minSubtotal" min="0" step="0.01" value="0">
        </div>
        <div>
          <label for="maxUses">Maximum total uses (leave blank for unlimited)</label>
          <input type="number" id="maxUses" name="maxUses" min="1" step="1">
        </div>
      </div>

      <div style="margin-top:26px;">
        <button type="submit" class="btn">Save</button>
        <a class="btn secondary" href="/admin/discounts">Cancel</a>
      </div>
    </form>
  </div>
</body>
</html>
