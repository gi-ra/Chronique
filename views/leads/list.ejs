<!DOCTYPE html>
<html lang="en">
<head><%- include('../partials/head', { pageTitle: 'Leads' }) %></head>
<body>
  <%- include('../partials/nav') %>
  <div class="wrap">
    <h1>Leads</h1>
    <p class="muted">Everyone who's left an email on the site — the newsletter/RSVP forms and back-in-stock requests.</p>

    <div style="display:flex; justify-content:space-between; align-items:center; margin-top:32px;">
      <h2 style="margin:0;">Mailing list (<%= subscribers.length %>)</h2>
      <a class="btn secondary" href="/admin/leads/subscribers.csv">Export CSV</a>
    </div>
    <% if (!subscribers.length) { %>
      <p class="empty">No signups yet — once someone uses the subscribe box or the Gathering RSVP, they'll show up here.</p>
    <% } else { %>
    <table>
      <thead>
        <tr><th>Email</th><th>Source</th><th>Date</th><th></th></tr>
      </thead>
      <tbody>
        <% subscribers.forEach(s => { %>
          <tr>
            <td><%= s.email %></td>
            <td><%= s.source || '—' %></td>
            <td><%= s.created_at %></td>
            <td>
              <form class="inline" method="POST" action="/admin/leads/subscribers/<%= s.id %>/delete" onsubmit="return confirm('Remove this subscriber?');">
                <button class="btn small danger">Remove</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
    <% } %>

    <div style="display:flex; justify-content:space-between; align-items:center; margin-top:48px;">
      <h2 style="margin:0;">Back-in-stock requests (<%= stockRequests.length %>)</h2>
      <a class="btn secondary" href="/admin/leads/stock-requests.csv">Export CSV</a>
    </div>
    <p class="muted">Emailed automatically the moment you top up that size/colour's stock in a product's edit page.</p>
    <% if (!stockRequests.length) { %>
      <p class="empty">No requests yet.</p>
    <% } else { %>
    <table>
      <thead>
        <tr><th>Email</th><th>Product</th><th>Size</th><th>Colour</th><th>Notified</th><th>Date</th></tr>
      </thead>
      <tbody>
        <% stockRequests.forEach(s => { %>
          <tr>
            <td><%= s.email %></td>
            <td><%= s.product_name || s.product_id %></td>
            <td><%= s.size %></td>
            <td><%= s.color %></td>
            <td><%= s.notified ? 'Yes' : 'No' %></td>
            <td><%= s.created_at %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
    <% } %>
  </div>
</body>
</html>
