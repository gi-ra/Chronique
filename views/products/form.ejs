<!DOCTYPE html>
<html lang="en">
<head><%- include('../partials/head', { pageTitle: product ? 'Edit product' : 'Add product' }) %></head>
<body>
  <%- include('../partials/nav') %>
  <div class="wrap">
    <h1><%= product ? 'Edit product' : 'Add product' %></h1>

    <form method="POST" action="<%= product ? '/admin/products/' + product.id : '/admin/products' %>" enctype="multipart/form-data" onsubmit="return document.getElementById('category').value.trim() ? true : (alert('Choose or add a category first.'), false);">
      <% if (!product) { %>
        <label for="id">ID (used in the product's URL, no spaces — e.g. "essential-tee")</label>
        <input type="text" id="id" name="id" required pattern="[a-z0-9\-]+" placeholder="essential-tee">
      <% } %>

      <label for="name">Name</label>
      <input type="text" id="name" name="name" required value="<%= product ? product.name : '' %>">

      <label>Product type</label>
      <div class="row" id="productTypeRow" style="gap:16px;">
        <% const currentType = product ? (product.product_type || 'garment') : 'garment'; %>
        <% [['garment','Garment'],['photo','Photo'],['accessory','Accessory']].forEach(([val,label]) => { %>
          <label style="font-weight:400; display:inline-flex; align-items:center; gap:6px; width:auto;">
            <input type="radio" name="productType" value="<%= val %>" style="width:auto;" <%= currentType===val ? 'checked' : '' %>>
            <%= label %>
          </label>
        <% }) %>
      </div>
      <p class="muted" id="productTypeHint" style="margin-top:-8px;"></p>

      <div class="row">
        <div>
          <label for="categorySelect">Category</label>
          <% const currentCategory = product ? product.category : ''; %>
          <% const categoryIsKnown = (categories || []).includes(currentCategory); %>
          <select id="categorySelect">
            <option value="" disabled <%= currentCategory ? '' : 'selected' %>>Choose a category…</option>
            <% (categories || []).forEach(cat => { %>
              <option value="<%= cat %>" <%= currentCategory === cat ? 'selected' : '' %>><%= cat %></option>
            <% }) %>
            <option value="__new__" <%= currentCategory && !categoryIsKnown ? 'selected' : '' %>>+ Add new category…</option>
          </select>
          <input type="text" id="newCategoryInput" placeholder="New category name" style="margin-top:8px; <%= (currentCategory && !categoryIsKnown) ? '' : 'display:none;' %>" value="<%= (currentCategory && !categoryIsKnown) ? currentCategory : '' %>">
          <p class="muted" id="newCategoryHint" style="margin-top:6px; <%= (currentCategory && !categoryIsKnown) ? '' : 'display:none;' %>">
            This will appear as a new category in the shop's filter menu as soon as you save.
          </p>
          <input type="hidden" id="category" name="category" required value="<%= currentCategory %>">
        </div>
        <div>
          <label for="price">Price (AUD)</label>
          <input type="number" id="price" name="price" step="0.01" required value="<%= product ? product.price : '' %>">
        </div>
      </div>

      <label>Collections</label>
      <p class="muted" style="margin-top:-4px;">
        Optional editorial groupings shown on the Collections page — separate from category
        above, which only drives the shop's filter menu. Tick any this product belongs to, or
        type new ones below (comma separated) to create and add them in one go.
      </p>
      <% const currentCollections = product ? (product.collections || []) : []; %>
      <div style="display:flex; gap:14px; flex-wrap:wrap;">
        <% (collections || []).forEach(c => { %>
          <label style="font-weight:400; display:inline-flex; align-items:center; gap:6px; width:auto;">
            <input type="checkbox" name="collections" value="<%= c.id %>" style="width:auto;" <%= currentCollections.includes(c.id) ? 'checked' : '' %>>
            <%= c.name %>
          </label>
        <% }) %>
      </div>
      <input type="text" id="newCollections" name="newCollections" placeholder="e.g. Studio Essentials, Curated" style="margin-top:10px;">

      <label for="icon">Icon</label>
      <select id="icon" name="icon">
        <% ['icon-tee','icon-crewneck','icon-coat','icon-trouser','icon-cap','icon-tote','icon-card'].forEach(ic => { %>
          <option value="<%= ic %>" <%= product && product.icon===ic ? 'selected' : '' %>><%= ic %></option>
        <% }) %>
      </select>

      <% const currentColorList = product ? product.colors.split(',').map(c => c.trim()).filter(Boolean) : []; %>
      <div id="colorsField">
        <label for="colors">Colours (comma separated)</label>
        <input type="text" id="colors" name="colors" value="<%= product ? product.colors : '' %>" placeholder="Ink, Ivory, Stone">
        <div id="colorPreview" style="display:flex; gap:8px; flex-wrap:wrap; margin-top:8px;"></div>
        <p class="muted" style="margin-top:6px;">Not case-sensitive. Any name not recognised shows as grey above and falls back to grey on the live site too — recognised names: Black, Ink, White, Ivory, Cream, Ecru, Stone, Sand, Taupe, Beige, Grey, Charcoal, Slate, Silver, Camel, Tan, Brown, Chocolate, Espresso, Cognac, Chestnut, Mahogany, Walnut, Rust, Terracotta, Clay, Mocha, Olive, Sage, Forest, Emerald, Green, Khaki, Mint, Moss, Navy, Denim, Indigo, Cobalt, Sky, Teal, Turquoise, Steel, Blue, Red, Burgundy, Maroon, Wine, Rose, Blush, Pink, Coral, Plum, Lavender, Purple, Mustard, Gold, Bronze, Orange, Apricot, Yellow, Peach.</p>
      </div>

      <div id="photoFormatField" style="display:none;">
        <label>Available as</label>
        <div style="display:flex; gap:16px; flex-wrap:wrap;">
          <% (photoFormats || []).forEach(fmt => { %>
            <label style="font-weight:400; display:inline-flex; align-items:center; gap:6px; width:auto;">
              <input type="checkbox" class="photo-format-check" value="<%= fmt %>" style="width:auto;" <%= currentColorList.includes(fmt) ? 'checked' : '' %>>
              <%= fmt %>
            </label>
          <% }) %>
        </div>
        <p class="muted" style="margin-top:6px;">Pick digital, one or more print materials, or both. Leave all unchecked to default to Digital only.</p>
      </div>

      <label for="sizes" id="sizesLabel">Sizes (comma separated — leave blank to use the default for this product type: XS–XL for garments, ONE SIZE otherwise)</label>
      <input type="text" id="sizes" name="sizes" value="<%= product ? product.sizes : '' %>" placeholder="XS, S, M, L, XL">

      <label>Size guide</label>
      <p class="muted" style="margin-top:-4px;">
        The measurements chart behind the "Size guide" link next to Size on this product's page.
        Left on Auto, it uses the shared chart for this product's category — pick "Tops" or
        "Bottoms" measurements below to enter this product's own numbers instead, since not every
        piece in a category is cut the same. Sizes with no match here just show 0 — fill in the
        ones this product actually comes in.
      </p>
      <% const currentGuideType = product ? (product.sizeGuideType || '') : ''; %>
      <div class="row" id="sizeGuideTypeRow" style="gap:16px; flex-wrap:wrap;">
        <% [['', 'Auto (based on category)'], ['tops', 'Tops measurements'], ['bottoms', 'Bottoms measurements'], ['none', 'No size guide']].forEach(([val, label]) => { %>
          <label style="font-weight:400; display:inline-flex; align-items:center; gap:6px; width:auto;">
            <input type="radio" name="sizeGuideType" value="<%= val %>" style="width:auto;" <%= currentGuideType===val ? 'checked' : '' %>>
            <%= label %>
          </label>
        <% }) %>
      </div>

      <% [['tops', sizeGuideEditorTops], ['bottoms', sizeGuideEditorBottoms]].forEach(([type, editor]) => { %>
        <div class="size-guide-table-field" data-guide-type="<%= type %>" style="display:none; margin-top:14px;">
          <table>
            <thead><tr><th>Size</th><% editor.columns.forEach(c => { %><th><%= c %></th><% }) %></tr></thead>
            <tbody>
              <% Object.keys(editor.rows).forEach(size => { %>
                <tr>
                  <td><%= size %></td>
                  <% editor.rows[size].forEach((v, i) => { %>
                    <td><input type="number" step="0.1" name="sizeGuideValue_<%= size %>_<%= i %>" value="<%= v %>" style="max-width:90px;"></td>
                  <% }) %>
                </tr>
              <% }) %>
            </tbody>
          </table>
          <p class="muted" style="margin-top:6px;">Inches. Shown converted to cm and Int'l sizing automatically on the product page.</p>
        </div>
      <% }) %>

      <% if (!product) { %>
        <label for="initialStock">Starting stock (applied to every size/colour combination this creates)</label>
        <input type="number" id="initialStock" name="initialStock" min="0" step="1" value="10">
      <% } %>

      <label>
        <input type="checkbox" name="isNew" value="1" <%= product && product.is_new ? 'checked' : '' %> style="width:auto; display:inline-block; margin-right:6px;">
        Mark as "New"
      </label>

      <label>
        <input type="checkbox" name="isCurated" value="1" <%= product && product.is_curated ? 'checked' : '' %> style="width:auto; display:inline-block; margin-right:6px;">
        Include in "Curated" (shown under the nav's Curated filter — independent of "New")
      </label>

      <label for="description">Description</label>
      <textarea id="description" name="description"><%= product ? product.description : '' %></textarea>

      <% if (product && product.photos.length) { %>
        <label>Existing photos (uncheck to remove, pick one as the main image)</label>
        <div class="photo-grid">
          <% product.photos.forEach((url, i) => { %>
            <div class="item">
              <img src="<%= url %>" alt="">
              <label style="margin:0; font-weight:400;">
                <input type="checkbox" name="keepPhotos" value="<%= url %>" checked style="width:auto;"> keep
              </label>
              <label style="margin:0; font-weight:400;">
                <input type="radio" name="mainPhoto" value="<%= url %>" <%= i === 0 ? 'checked' : '' %> style="width:auto;"> main
              </label>
            </div>
          <% }) %>
        </div>
      <% } %>

      <label for="newPhotos">Add photos (becomes the main image only if no existing photo is picked as main above)</label>
      <input type="file" id="newPhotos" name="newPhotos" accept="image/*" multiple>

      <h2>Info sections</h2>
      <p class="muted">
        Shown as expandable sections on this product's page — "Composition &amp; care" and
        "Shipping &amp; returns" are here by default since cuts and care differ, but you can
        reword either one, delete a section this product doesn't need, or add more (a "Fit
        notes" section, say). Leave a section's title blank to remove it when you save.
      </p>
      <div id="infoSections">
        <% const sectionsForForm = product ? (product.infoSections || []) : (defaultInfoSections || []); %>
        <% sectionsForForm.forEach(sec => { %>
          <div class="info-section-row" style="border:1px solid var(--line); border-radius:8px; padding:14px; margin-bottom:12px;">
            <input type="text" name="infoTitle" placeholder="Section title" value="<%= sec.title %>">
            <textarea name="infoBody" placeholder="Section text" style="margin-top:8px;"><%= sec.body %></textarea>
            <button type="button" class="btn small secondary remove-info-section" style="margin-top:8px;">Remove section</button>
          </div>
        <% }) %>
      </div>
      <button type="button" id="addInfoSectionBtn" class="btn small secondary">+ Add another section</button>

      <% if (product && variants && variants.length) { %>
        <h2>Stock</h2>
        <p class="muted">
          One row per size/colour combination, worked out from the sizes and colours above
          (or the category's default sizes if the sizes field is left blank).
          Change the sizes, category or colours and save to add or remove rows — new rows
          start at 0 until you set a number here and save again.
        </p>
        <table>
          <thead><tr><th>Size</th><th>Colour</th><th>In stock</th></tr></thead>
          <tbody>
            <% variants.forEach(v => { %>
              <tr>
                <td><%= v.size %></td>
                <td><%= v.color %></td>
                <td style="max-width:110px;">
                  <input type="number" name="stock[<%= v.id %>]" min="0" step="1" value="<%= v.stock %>">
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>

      <div style="margin-top:26px;">
        <button type="submit" class="btn">Save</button>
        <a class="btn secondary" href="/admin/products">Cancel</a>
      </div>
    </form>
  </div>
  <script>
    (function(){
      const radios = document.querySelectorAll('input[name="productType"]');
      const colorsField = document.getElementById('colorsField');
      const photoFormatField = document.getElementById('photoFormatField');
      const formatChecks = document.querySelectorAll('.photo-format-check');
      const colorsInput = document.getElementById('colors');
      const colorPreview = document.getElementById('colorPreview');
      const sizesInput = document.getElementById('sizes');
      const hint = document.getElementById('productTypeHint');

      // Kept in sync with the COLORS map in public/js/site.js — this is
      // just for the live swatch preview below the input, so an admin
      // catches a typo'd colour name before it goes out grey on the site.
      const COLORS = {
        Black:"#121110", Ink:"#121110", White:"#FFFFFF", Ivory:"#EFEBDE", Cream:"#F3EAD8", Ecru:"#E8E1CF",
        Stone:"#C9C2B3", Sand:"#D9CBAE", Taupe:"#B8A99A", Beige:"#D8C9AE", Grey:"#8C887E", Gray:"#8C887E",
        Charcoal:"#2B2A27", Slate:"#4C5459", Silver:"#B8B8B2",
        Camel:"#A9744F", Tan:"#C8A671", Brown:"#7A4430", Chocolate:"#3E2723", Espresso:"#3B2A21",
        Cognac:"#8A4B2D", Chestnut:"#6B3A2A", Mahogany:"#4E2A22", Walnut:"#5A3A2A", Rust:"#B35A32",
        Terracotta:"#C1653D", Clay:"#A9633E", Mocha:"#5C4433",
        Olive:"#5B5B42", Sage:"#9CAE8C", Forest:"#31462B", Emerald:"#2E5D45", Green:"#3D6B4C",
        Khaki:"#8C8465", Mint:"#B7D9C6", Moss:"#5B6B3F",
        Navy:"#1F2937", Denim:"#3A597A", Indigo:"#334066", Cobalt:"#2F5D8A", Sky:"#8FB6D9",
        Teal:"#2F6B69", Turquoise:"#2FA6A0", Steel:"#5C6E77", Blue:"#33587A",
        Red:"#8C2B22", Burgundy:"#5C1F2A", Maroon:"#4A1E22", Wine:"#5E1F2E", Rose:"#C48B8F",
        Blush:"#E3C6C4", Pink:"#D9A9AC", Coral:"#D97456", Plum:"#5A3A50", Lavender:"#B7A6C9", Purple:"#5B3B5E",
        Mustard:"#B98A2A", Gold:"#B8963E", Bronze:"#8A6A32", Orange:"#C1602A", Apricot:"#D99A5B",
        Yellow:"#D9B23E", Peach:"#E3B79A"
      };
      function colorHex(name){
        const key = Object.keys(COLORS).find(k => k.toLowerCase() === name.trim().toLowerCase());
        return key ? COLORS[key] : '#999';
      }
      function renderColorPreview(){
        const names = colorsInput.value.split(',').map(s => s.trim()).filter(Boolean);
        colorPreview.innerHTML = names.map(n =>
          `<span title="${n}" style="display:inline-block;width:22px;height:22px;border-radius:50%;background:${colorHex(n)};border:1px solid rgba(0,0,0,0.15);"></span>`
        ).join('');
      }
      colorsInput.addEventListener('input', renderColorPreview);
      renderColorPreview();

      const HINTS = {
        garment: 'Standard apparel. Defaults to sizes XS–XL unless you set custom sizes above.',
        photo: 'A print or photograph. No colour picker is shown to customers. Leave sizes blank for a one-of-a-kind piece, or list print sizes (e.g. A4, A3, A2).',
        accessory: 'A one-off or ONE SIZE item by default. Leave sizes blank unless it comes in multiple sizes.'
      };
      const SIZE_PLACEHOLDERS = {
        garment: 'XS, S, M, L, XL',
        photo: 'A4, A3, A2 (leave blank for one-of-a-kind)',
        accessory: 'leave blank for ONE SIZE'
      };

      function currentType(){
        const checked = document.querySelector('input[name="productType"]:checked');
        return checked ? checked.value : 'garment';
      }

      function syncFormatsToColorsInput(){
        const checked = Array.from(formatChecks).filter(c => c.checked).map(c => c.value);
        colorsInput.value = checked.join(', ');
      }

      const PHOTO_FORMATS = <%- JSON.stringify(photoFormats || []) %>;
      let lastType = currentType();

      function applyType(){
        const type = currentType();
        const isPhoto = type === 'photo';
        colorsField.style.display = isPhoto ? 'none' : '';
        photoFormatField.style.display = isPhoto ? '' : 'none';
        sizesInput.placeholder = SIZE_PLACEHOLDERS[type] || '';
        hint.textContent = HINTS[type] || '';
        if (isPhoto) {
          syncFormatsToColorsInput();
        } else if (lastType === 'photo') {
          // Leaving photo type: clear the auto-filled format list so it
          // doesn't get saved as if it were a real colour list.
          const parts = colorsInput.value.split(',').map(s => s.trim()).filter(Boolean);
          if (parts.every(p => PHOTO_FORMATS.includes(p))) colorsInput.value = '';
        }
        lastType = type;
      }

      radios.forEach(r => r.addEventListener('change', applyType));
      formatChecks.forEach(c => c.addEventListener('change', syncFormatsToColorsInput));
      applyType();
    })();

    (function(){
      const select = document.getElementById('categorySelect');
      const newInput = document.getElementById('newCategoryInput');
      const newHint = document.getElementById('newCategoryHint');
      const hidden = document.getElementById('category');

      function sync(){
        if(select.value === '__new__'){
          newInput.style.display = '';
          newHint.style.display = '';
          hidden.value = newInput.value.trim();
        }else{
          newInput.style.display = 'none';
          newHint.style.display = 'none';
          hidden.value = select.value;
        }
      }
      select.addEventListener('change', sync);
      newInput.addEventListener('input', () => { hidden.value = newInput.value.trim(); });
      sync();
    })();

    (function(){
      const radios = document.querySelectorAll('input[name="sizeGuideType"]');
      const tableFields = document.querySelectorAll('.size-guide-table-field');
      function applySizeGuideType(){
        const checked = document.querySelector('input[name="sizeGuideType"]:checked');
        const val = checked ? checked.value : '';
        tableFields.forEach(field => {
          field.style.display = field.dataset.guideType === val ? '' : 'none';
        });
      }
      radios.forEach(r => r.addEventListener('change', applySizeGuideType));
      applySizeGuideType();
    })();

    (function(){
      const container = document.getElementById('infoSections');
      const addBtn = document.getElementById('addInfoSectionBtn');

      function wireRemove(row){
        row.querySelector('.remove-info-section').addEventListener('click', () => row.remove());
      }
      container.querySelectorAll('.info-section-row').forEach(wireRemove);

      addBtn.addEventListener('click', () => {
        const row = document.createElement('div');
        row.className = 'info-section-row';
        row.style.cssText = 'border:1px solid var(--line); border-radius:8px; padding:14px; margin-bottom:12px;';
        row.innerHTML = `
          <input type="text" name="infoTitle" placeholder="Section title">
          <textarea name="infoBody" placeholder="Section text" style="margin-top:8px;"></textarea>
          <button type="button" class="btn small secondary remove-info-section" style="margin-top:8px;">Remove section</button>
        `;
        container.appendChild(row);
        wireRemove(row);
        row.querySelector('input').focus();
      });
    })();
  </script>
</body>
</html>
