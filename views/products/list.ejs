<!DOCTYPE html>
<html lang="en">
<head><%- include('../partials/head', { pageTitle: 'Products' }) %></head>
<body>
  <%- include('../partials/nav') %>
  <div class="wrap">
    <div style="display:flex; justify-content:space-between; align-items:center;">
      <h1>Products</h1>
      <div>
        <a class="btn secondary" href="/admin/products/import">Import from CSV</a>
        <a class="btn" href="/admin/products/new">+ Add product</a>
      </div>
    </div>

    <% if (!products.length) { %>
      <p class="empty">No products yet.</p>
    <% } else { %>
    <div class="row" style="margin:18px 0;">
      <div>
        <input type="text" id="productSearch" placeholder="Search by name or category…">
      </div>
      <div style="max-width:200px;">
        <select id="stockFilter">
          <option value="">All stock levels</option>
          <option value="out">Sold out</option>
          <option value="low">Running low</option>
          <option value="ok">In stock</option>
        </select>
      </div>
    </div>
    <p class="muted" id="productCount"></p>
    <table id="productsTable">
      <thead>
        <tr><th></th><th>Name</th><th>Category</th><th>Price</th><th>Stock</th><th>New</th><th></th></tr>
      </thead>
      <tbody id="productsBody">
        <% products.forEach((p, i) => { %>
          <tr data-name="<%= p.name.toLowerCase() %>" data-category="<%= p.category.toLowerCase() %>" data-stock="<%= p.stockState %>">
            <td><img class="thumb" src="<%= p.photos[0] || '' %>" alt=""></td>
            <td><%= p.name %></td>
            <td><%= p.category %></td>
            <td>$<%= p.price %></td>
            <td>
              <% if (p.stockState === 'out') { %>
                <span class="stock-pill stock-out">Sold out</span>
              <% } else if (p.stockState === 'low') { %>
                <span class="stock-pill stock-low"><%= p.totalStock %> left</span>
              <% } else { %>
                <span class="stock-pill stock-ok"><%= p.totalStock %> in stock</span>
              <% } %>
            </td>
            <td><%= p.is_new ? 'Yes' : '' %></td>
            <td style="white-space:nowrap;">
              <form class="inline" method="POST" action="/admin/products/<%= p.id %>/move">
                <input type="hidden" name="direction" value="up">
                <button class="btn small secondary" <%= i===0 ? 'disabled' : '' %>>&uarr;</button>
              </form>
              <form class="inline" method="POST" action="/admin/products/<%= p.id %>/move">
                <input type="hidden" name="direction" value="down">
                <button class="btn small secondary" <%= i===products.length-1 ? 'disabled' : '' %>>&darr;</button>
              </form>
              <a class="btn small secondary" href="/admin/products/<%= p.id %>/edit">Edit</a>
              <form class="inline" method="POST" action="/admin/products/<%= p.id %>/duplicate">
                <button class="btn small secondary">Duplicate</button>
              </form>
              <form class="inline" method="POST" action="/admin/products/<%= p.id %>/delete" onsubmit="return confirm('Delete this product?');">
                <button class="btn small danger">Delete</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
    <div id="productsPager" style="display:flex; justify-content:center; align-items:center; gap:10px; margin-top:22px;"></div>
    <% } %>
  </div>
  <style>
    .stock-pill{ display:inline-block; padding:3px 10px; border-radius:100px; font-size:12px; white-space:nowrap; }
    .stock-pill.stock-ok{ background:#EAF3EA; color:#2E6B33; }
    .stock-pill.stock-low{ background:#FCF3E3; color:#9A6A15; }
    .stock-pill.stock-out{ background:#FBEAE9; color:#B3261E; }
  </style>
  <script>
    (function(){
      const PAGE_SIZE = 50;
      const search = document.getElementById('productSearch');
      const stockFilter = document.getElementById('stockFilter');
      const rows = Array.from(document.querySelectorAll('#productsBody tr'));
      const countEl = document.getElementById('productCount');
      const pagerEl = document.getElementById('productsPager');
      let page = 1;

      function matching(){
        const q = (search.value || '').trim().toLowerCase();
        const stock = stockFilter.value;
        return rows.filter(row => {
          const matchesText = !q || row.dataset.name.includes(q) || row.dataset.category.includes(q);
          const matchesStock = !stock || row.dataset.stock === stock;
          return matchesText && matchesStock;
        });
      }

      function apply(){
        const matched = matching();
        const totalPages = Math.max(1, Math.ceil(matched.length / PAGE_SIZE));
        page = Math.min(page, totalPages);
        const start = (page - 1) * PAGE_SIZE;
        const pageRows = new Set(matched.slice(start, start + PAGE_SIZE));

        rows.forEach(row => { row.style.display = pageRows.has(row) ? '' : 'none'; });

        countEl.textContent = matched.length === rows.length
          ? `${rows.length} products`
          : `Showing ${matched.length} of ${rows.length} products`;

        pagerEl.innerHTML = '';
        if (totalPages > 1) {
          const prev = document.createElement('button');
          prev.className = 'btn small secondary';
          prev.textContent = '← Prev';
          prev.disabled = page <= 1;
          prev.onclick = () => { page--; apply(); };

          const label = document.createElement('span');
          label.className = 'muted';
          label.textContent = `Page ${page} of ${totalPages}`;

          const next = document.createElement('button');
          next.className = 'btn small secondary';
          next.textContent = 'Next →';
          next.disabled = page >= totalPages;
          next.onclick = () => { page++; apply(); };

          pagerEl.append(prev, label, next);
        }
      }

      search.addEventListener('input', () => { page = 1; apply(); });
      stockFilter.addEventListener('change', () => { page = 1; apply(); });
      apply();
    })();
  </script>
</body>
</html>
