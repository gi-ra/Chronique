<!DOCTYPE html>
<html lang="en">
<head><%- include('../partials/head', { pageTitle: 'Orders' }) %></head>
<body>
  <%- include('../partials/nav') %>
  <div class="wrap">
    <div style="display:flex; justify-content:space-between; align-items:center;">
      <h1>Orders</h1>
      <div>
        <a class="btn secondary" href="/admin/orders.csv">Export CSV</a>
        <a class="btn" href="/admin/orders/new">+ Record phone/in-person order</a>
      </div>
    </div>

    <form method="GET" action="/admin/orders" class="row" style="margin:18px 0;">
      <div>
        <input type="text" name="q" value="<%= q %>" placeholder="Search by order #, customer or email…">
      </div>
      <div style="max-width:200px;">
        <select name="status" onchange="this.form.submit()">
          <option value="">All statuses</option>
          <% allStatuses.forEach(s => { %>
            <option value="<%= s %>" <%= status === s ? 'selected' : '' %>><%= s %></option>
          <% }) %>
        </select>
      </div>
      <div>
        <button type="submit" class="btn secondary">Search</button>
      </div>
    </form>

    <% if (!orders.length) { %>
      <p class="empty">No orders match.</p>
    <% } else { %>
    <p class="muted">Showing <%= orders.length %> of <%= totalCount %> order<%= totalCount === 1 ? '' : 's' %><%= totalPages > 1 ? ` — page ${currentPage} of ${totalPages}` : '' %></p>
    <table id="ordersTable">
      <thead>
        <tr><th>#</th><th>Date</th><th>Channel</th><th>Customer</th><th>Status</th><th>Total</th><th></th></tr>
      </thead>
      <tbody>
        <% orders.forEach(o => { %>
          <tr>
            <td>#<%= o.id %></td>
            <td><%= o.created_at %></td>
            <td><%= o.channel %></td>
            <td><%= o.customer_name || o.customer_email || '—' %></td>
            <td><%= o.status %></td>
            <td>$<%= (o.total_cents / 100).toFixed(2) %></td>
            <td><a class="btn small secondary" href="/admin/orders/<%= o.id %>">View</a></td>
          </tr>
        <% }) %>
      </tbody>
    </table>

    <% if (totalPages > 1) { %>
      <% const qs = (p) => `?q=${encodeURIComponent(q)}&status=${encodeURIComponent(status)}&page=${p}`; %>
      <div style="display:flex; justify-content:center; gap:10px; margin-top:22px;">
        <a class="btn small secondary" href="<%= qs(currentPage - 1) %>" <%= currentPage <= 1 ? 'style="pointer-events:none;opacity:.4;"' : '' %>>&larr; Prev</a>
        <span class="muted" style="align-self:center;">Page <%= currentPage %> of <%= totalPages %></span>
        <a class="btn small secondary" href="<%= qs(currentPage + 1) %>" <%= currentPage >= totalPages ? 'style="pointer-events:none;opacity:.4;"' : '' %>>Next &rarr;</a>
      </div>
    <% } %>
    <% } %>
  </div>
</body>
</html>
