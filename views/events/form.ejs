<!DOCTYPE html>
<html lang="en">
<head><%- include('../partials/head', { pageTitle: event ? 'Edit event' : 'Add event' }) %></head>
<body>
  <%- include('../partials/nav') %>
  <div class="wrap">
    <h1><%= event ? 'Edit event' : 'Add event' %></h1>

    <form method="POST" action="<%= event ? '/admin/events/' + event.id : '/admin/events' %>" enctype="multipart/form-data">
      <label for="title">Title</label>
      <input type="text" id="title" name="title" required value="<%= event ? event.title : '' %>" placeholder="The Autumn Gathering">

      <div class="row">
        <div>
          <label for="eventDate">Date</label>
          <input type="date" id="eventDate" name="eventDate" required value="<%= event ? event.event_date : '' %>">
        </div>
        <div>
          <label for="eventTime">Time (shown as-is, optional)</label>
          <input type="text" id="eventTime" name="eventTime" value="<%= event ? event.event_time : '' %>" placeholder="6:00 PM">
        </div>
      </div>

      <label for="location">Location</label>
      <input type="text" id="location" name="location" value="<%= event ? event.location : '' %>" placeholder="Logan, QLD">

      <label for="description">Description</label>
      <textarea id="description" name="description"><%= event ? event.description : '' %></textarea>

      <% if (event && event.photo) { %>
        <label>Current photo</label>
        <img src="<%= event.photo %>" style="width:180px; border-radius:8px; display:block;" alt="">
      <% } %>
      <label for="photo">Photo <%= event ? '(leave blank to keep current)' : '' %></label>
      <input type="file" id="photo" name="photo" accept="image/*">

      <div style="margin-top:26px;">
        <button type="submit" class="btn">Save</button>
        <a class="btn secondary" href="/admin/events">Cancel</a>
      </div>
    </form>
  </div>
</body>
</html>
