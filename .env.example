# Copy this file to .env and fill in your own values before running the app.

# A long random string used to sign login sessions. Any long random text works.
# You can generate one at https://randomkeygen.com/ (use a "CodeIgniter Encryption Key")
SESSION_SECRET=change-this-to-a-long-random-string

# The username you will type in on the /admin login page.
ADMIN_USERNAME=admin

# Run `npm run hash-password` and paste the output here. Do NOT put your plain
# password here — only the hashed version that command prints out.
ADMIN_PASSWORD_HASH=

# Port the server listens on. Render/Railway set this automatically, so you
# usually don't need to change it — this default is only used when running
# on your own machine.
PORT=3000

# --- Stripe (payments) ---
# From https://dashboard.stripe.com/test/apikeys while in TEST MODE.
# Use your test keys until you're ready to take real payments.
STRIPE_SECRET_KEY=

# From the webhook you create at https://dashboard.stripe.com/test/webhooks
# (or printed by the Stripe CLI when testing locally). See README.md.
STRIPE_WEBHOOK_SECRET=

# The public URL of your site, no trailing slash. Used to build the
# checkout success/cancel links. Locally this is http://localhost:3000;
# once deployed, use your real domain (e.g. https://chronique.au).
SITE_URL=http://localhost:3000

# --- Email (order confirmations, shipping updates, alerts) ---
# From https://resend.com — free to sign up, no credit card needed for
# testing. Leave this blank and the app still works; it just prints emails
# to the server log instead of sending them, which is fine for local dev.
RESEND_API_KEY=

# The "from" address on emails this app sends. Until you verify your own
# domain with Resend, leave this as their shared onboarding address — real
# domains (e.g. orders@chronique.au) need to be verified in the Resend
# dashboard first (see README).
MAIL_FROM=Chronique <onboarding@resend.dev>

# Where "new order" and "low stock" alerts get sent. Leave blank to skip
# these alerts entirely (order confirmation emails to customers still work
# without this).
ADMIN_ALERT_EMAIL=

# --- Klaviyo (newsletter sign-ups) ---
# Every sign-up (nav drawer, homepage, Gathering RSVP, restock "Notify me",
# and checkout's "Keep me updated" box) is always saved to this app's own
# database first regardless of these — Klaviyo is an extra sync on top.
# Leave both blank and everything still works; sign-ups just aren't pushed
# to Klaviyo (check /admin > Leads and its CSV export instead).
#
# KLAVIYO_API_KEY: log into Klaviyo > click your account name (bottom
# left) > Settings > API Keys > Private API Keys > "Create Private API
# Key". Name it something like "Chronique website", and under Scopes give
# it "Full Access Key" (or at minimum Profiles: Full Access and
# Subscriptions: Full Access). Klaviyo shows the key once — copy it
# immediately (it starts with "pk_"). Paste it here, or as an environment
# variable in Render — never into any file that gets committed to GitHub.
KLAVIYO_API_KEY=

# KLAVIYO_LIST_ID: in Klaviyo, go to Lists & Segments (left sidebar) and
# open the list you want sign-ups added to (or create a new one, e.g.
# "Chronique website sign-ups"). The ID is in the page's URL —
# app.klaviyo.com/list/XXXXXX/... — copy the XXXXXX part. It's also shown
# under that list's Settings tab.
KLAVIYO_LIST_ID=
